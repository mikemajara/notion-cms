{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Root",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@notion-utils/types": ["packages/notion-types/dist/index.d.ts"],
      "@notion-utils/types/*": ["packages/notion-types/dist/*"]
    }
  },
  "exclude": ["node_modules"]
}
